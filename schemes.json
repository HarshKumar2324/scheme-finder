[
  {
    "id": "pm-kisan",
    "name": {
      "en": "PM Kisan Samman Nidhi",
      "hi": "प्रधानमंत्री किसान सम्मान निधि"
    },
    "benefit": {
      "en": "₹6,000 per year in three instalments",
      "hi": "तीन किस्तों में ₹6,000 प्रति वर्ष"
    },
    "benefitValue": 6000,
    "applyUrl": "https://pmkisan.gov.in/",
    "documents": [
      { "en": "Aadhaar", "hi": "आधार" },
      { "en": "Land ownership records", "hi": "भूमि स्वामित्व के अभिलेख" },
      { "en": "Bank passbook", "hi": "बैंक पासबुक" },
      { "en": "Mobile number", "hi": "मोबाइल नंबर" }
    ],
    "rules": [
      {
        "field": "occupation",
        "op": "in",
        "value": ["farmer"],
        "label_en": "Occupation is farmer",
        "label_hi": "व्यवसाय किसान है"
      },
      {
        "field": "ownsLand",
        "op": "eq",
        "value": true,
        "label_en": "Owns agricultural land",
        "label_hi": "कृषि भूमि का स्वामित्व है"
      }
    ]
  },
  {
    "id": "pm-mudra",
    "name": {
      "en": "PM Mudra Yojana",
      "hi": "प्रधानमंत्री मुद्रा योजना"
    },
    "benefit": {
      "en": "Loan up to ₹10 lakh for non-farm micro enterprises",
      "hi": "गैर-कृषि सूक्ष्म उद्यमों के लिए ₹10 लाख तक का ऋण"
    },
    "benefitValue": 0,
    "applyUrl": "https://www.udyamimitra.in/",
    "documents": [
      { "en": "Aadhaar", "hi": "आधार" },
      { "en": "PAN card", "hi": "पैन कार्ड" },
      { "en": "Business proof", "hi": "व्यवसाय का प्रमाण" },
      { "en": "Address proof", "hi": "पते का प्रमाण" },
      { "en": "6-month bank statement", "hi": "6 महीने का बैंक स्टेटमेंट" }
    ],
    "rules": [
      {
        "field": "age",
        "op": "min",
        "value": 18,
        "label_en": "Age is at least 18",
        "label_hi": "आयु कम से कम 18 वर्ष है"
      },
      {
        "anyOf": [
          { "field": "hasBusiness", "op": "eq", "value": true },
          { "field": "occupation", "op": "in", "value": ["selfemployed"] }
        ],
        "label_en": "Has a business or is self-employed",
        "label_hi": "व्यवसाय है या स्व-रोज़गार है"
      }
    ]
  },
  {
    "id": "stand-up-india",
    "name": {
      "en": "Stand-Up India",
      "hi": "स्टैंड-अप इंडिया"
    },
    "benefit": {
      "en": "Bank loan of ₹10 lakh to ₹1 crore for a greenfield enterprise",
      "hi": "नई इकाई के लिए ₹10 लाख से ₹1 करोड़ तक का बैंक ऋण"
    },
    "benefitValue": 0,
    "applyUrl": "https://www.standupmitra.in/",
    "documents": [
      { "en": "Aadhaar", "hi": "आधार" },
      { "en": "PAN card", "hi": "पैन कार्ड" },
      { "en": "Caste certificate (if SC/ST)", "hi": "जाति प्रमाण पत्र (यदि एससी/एसटी)" },
      { "en": "Business plan", "hi": "व्यवसाय योजना" },
      { "en": "Address proof", "hi": "पते का प्रमाण" }
    ],
    "rules": [
      {
        "field": "age",
        "op": "min",
        "value": 18,
        "label_en": "Age is at least 18",
        "label_hi": "आयु कम से कम 18 वर्ष है"
      },
      {
        "anyOf": [
          { "field": "gender", "op": "eq", "value": "female" },
          { "field": "category", "op": "in", "value": ["SC", "ST"] }
        ],
        "label_en": "Applicant is a woman or belongs to SC/ST",
        "label_hi": "आवेदक महिला है या एससी/एसटी श्रेणी से है"
      },
      {
        "anyOf": [
          { "field": "hasBusiness", "op": "eq", "value": true },
          {
            "field": "occupation",
            "op": "in",
            "value": ["selfemployed", "unemployed"]
          }
        ],
        "label_en": "Has a business, is self-employed, or is unemployed",
        "label_hi": "व्यवसाय है, स्व-रोज़गार है, या बेरोज़गार है"
      }
    ]
  },
